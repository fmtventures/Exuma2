{
  "name": "sidelio",
  "version": "0.1.0",
  "private": true,
  "description": "Sidelio Website Builder \u2014 multi-tenant AI website platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node --experimental-strip-types src/demo/rebuild.ts",
    "dev": "node --experimental-strip-types src/api/main.ts"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
