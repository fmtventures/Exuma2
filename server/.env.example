# Copy to .env for local work. In production set these in the host's dashboard
# instead — this file should never hold real keys.

# The public https address of the site. Stripe sends guests back here after
# paying, so it has to be the address guests actually use.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Google Calendar — the bookings calendar's ID, and the service account that
# has been given "Make changes to events" on it.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or point at the key file instead of pasting it:
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Stripe — test keys until the campground is ready to take real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs the cancellation links that go out in confirmation emails. Set a long
# random string and keep it stable — changing it invalidates links already sent.
BOOKING_SECRET=

# Email. Without these the server still takes bookings and writes what it would
# have sent to the log. SMTP_URL is the quickest route, e.g.
#   smtps://camp%40allpointseastcampground.ca:APP_PASSWORD@smtp.gmail.com:465
SMTP_URL=
# ...or the pieces separately:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=1
MAIL_FROM="All Points East Campground <camp@allpointseastcampground.ca>"
OFFICE_EMAIL=camp@allpointseastcampground.ca

# Sample rates, in-memory calendar, simulated payments. Never set in production.
# DEMO=1
